{
  "name": "glic-kit",
  "version": "1.0.3",
  "description": "Chrome Gemini AI one-click unlock tool for all platforms",
  "homepage": "https://github.com/normal-coder/glic-kit",
  "type": "module",
  "bin": {
    "glic-kit": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build.ts",
    "start": "node dist/index.js",
    "check": "bun run src/index.ts check",
    "fix": "bun run src/index.ts fix",
    "restore": "bun run src/index.ts restore",
    "help": "bun run src/index.ts --help",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "chrome",
    "gemini",
    "glic",
    "ai",
    "unlock",
    "chrome-ai"
  ],
  "author": {
    "email": "normal@normalcoder.com",
    "name": "诺墨",
    "url": "https://normalcoder.com"
  },
  "license": "MIT",
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^6.2.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.0.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.8",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.8.3"
  }
}
